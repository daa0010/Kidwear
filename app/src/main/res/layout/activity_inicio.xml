<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- CABECERA: Logo + Marca (Horizontal) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/tv_marca"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:lineHeight="20sp"
            android:text="@string/marca"
            android:textColor="@color/primary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- PORTADA: Ilustración -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_portada"
        android:layout_width="192dp"
        android:layout_height="192dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="35dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/iv_portada"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/titulo_inicio"
            android:scaleType="fitCenter"
            android:src="@drawable/img_portada" />
    </com.google.android.material.card.MaterialCardView>

    <!-- TÍTULO: Iniciar sesión -->
    <TextView
        android:id="@+id/tv_titulo"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:lineHeight="28sp"
        android:text="@string/titulo_inicio"
        android:textColor="@color/on_surface"
        android:textSize="22sp" />

    <!-- INPUT: Correo electrónico (328 x 56 dp) -->
    <EditText
        android:id="@+id/et_email"
        android:layout_width="328dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_input_email"
        android:hint="@string/hint_email"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        android:lineHeight="24sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/on_surface_variant"
        android:textSize="16sp" />

    <!-- INPUT: Contraseña (328 x 56 dp) -->
    <EditText
        android:id="@+id/et_password"
        android:layout_width="328dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_password"
        android:hint="@string/hint_password"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:lineHeight="24sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/on_surface_variant"
        android:textSize="16sp" />

    <!-- ENLACE: ¿Has olvidado tu contraseña? -->
    <TextView
        android:id="@+id/tv_olvido_password"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:lineHeight="16sp"
        android:text="@string/olvido_password"
        android:textColor="@color/primary"
        android:textSize="12sp" />

    <!-- FILA: Términos y condiciones (328 dp de ancho) -->
    <LinearLayout
        android:layout_width="328dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_terminos"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/terminos_condiciones"
            app:buttonTint="@color/outline"
            tools:ignore="TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/tv_terminos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:lineHeight="16sp"
            android:text="@string/terminos_condiciones"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- BOTÓN: Entrar (328 x 48 dp) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_login"
        android:layout_width="328dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="22dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:backgroundTint="@color/primary"
        android:lineHeight="20sp"
        android:text="@string/btn_entrar"
        android:textColor="@color/on_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="24dp" />

    <!-- BOTÓN: Continuar con Google (328 x 48 dp) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_google"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="328dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:backgroundTint="@color/surface"
        android:lineHeight="20sp"
        android:text="@string/btn_google"
        android:textColor="@color/on_surface"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_google"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="20dp"
        app:iconTint="@null"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp" />

    <!-- PIE: ¿No tienes cuenta? Regístrate (Separación 24dp arriba y 60dp abajo) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="60dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_no_cuenta"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            android:lineHeight="20sp"
            android:text="@string/no_cuenta"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_registro"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:lineHeight="20sp"
            android:text="@string/registro"
            android:textColor="@color/primary"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>